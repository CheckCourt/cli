{
  "name": "@checkcourt/cli",
  "version": "0.1.2",
  "description": "Command line tool for the CheckCourt API and local app development",
  "private": false,
  "license": "MIT",
  "author": "CheckCourt",
  "homepage": "https://github.com/CheckCourt/cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CheckCourt/cli.git"
  },
  "bugs": {
    "url": "https://github.com/CheckCourt/cli/issues"
  },
  "keywords": [
    "checkcourt",
    "cli",
    "webhooks",
    "developer-tools"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "checkcourt": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "ink": "^6.8.0",
    "ink-text-input": "^6.0.0",
    "openapi-fetch": "^0.13.0",
    "react": "19.2.4",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@checkcourt/sdk": "git+https://github.com/CheckCourt/sdk.git#v0.3.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.6"
  }
}
